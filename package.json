{
  "name": "risecue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Garmin Connect IQ wake-alert app plus a small ICS-to-JSON calendar endpoint.",
  "scripts": {
    "build:watch": "scripts/build-watch.sh",
    "build:watch:public": "node --env-file-if-exists=.env scripts/build-watch-public.mjs",
    "package:watch": "scripts/package-watch.sh",
    "package:watch:public": "node --env-file-if-exists=.env scripts/package-watch-public.mjs",
    "start": "node --env-file=.env endpoint/server.mjs",
    "test": "node --test endpoint/*.test.mjs"
  },
  "dependencies": {
    "node-ical": "^0.27.1"
  },
  "engines": {
    "node": ">=20"
  }
}
