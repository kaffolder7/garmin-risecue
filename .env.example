# Endpoint runtime values. Use these when running `npm start` locally or when
# deploying your own self-hosted endpoint service.
CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/private-calendar/basic.ics
CALENDAR_TIME_ZONE=America/New_York
# For self-hosted endpoints, enter this same value in the Garmin
# "Calendar endpoint token" app setting. Normal `build:watch` binaries do not
# embed this token.
ENDPOINT_TOKEN=replace-with-a-long-random-token
ALLOW_REQUEST_CALENDAR_URL=false

# Public watch build value. Set this only when building binaries that should use
# the built-in public endpoint at https://risecue.affolder.dev/next-morning-event.
# It must match the deployed public endpoint's ENDPOINT_TOKEN.
RISECUE_PUBLIC_ENDPOINT_TOKEN=the-shared-public-endpoint-secret

# Optional watch build metadata. Normal watch build scripts read these when
# exported or provided inline; public watch wrappers also load them from `.env`.
# RISECUE_APP_BUILD_VERSION=0.1.0
# RISECUE_SHOW_BUILD_VERSION=true

PRIVACY_CONTACT_EMAIL=privacy@example.com
PRIVACY_EFFECTIVE_DATE="April 28, 2026"
PRIVACY_PUBLIC_ENDPOINT_ORIGIN=https://public-host.example.com
PORT=8787
